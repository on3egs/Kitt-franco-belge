# Configuration HYPER FLUIDE pour Kyronext - Orin Nano 8Go
KYRONEX_MACHINE_ID=karr_dadoo
KYRONEX_CHARACTER_LOCK=KARR
KYRONEX_MAINTENANCE_MODE=0
KYRONEX_VOICE_EFFECT_DEFAULT=none
# Optimisé pour des réponses INSTANTANEES (répond AVANT même la fin de la phrase)
# Date: 2026-07-29
# Modèle: Qwen 2.5 3B Q5_K_M
# Objectif: Répondre et PARLER en parallèle de la génération du texte

# ============================================================================
# Paramètres LLM (llama-server / Ollama) - OPTIMISE POUR LA LATENCE
# ============================================================================
OLLAMA_HOST=http://127.0.0.1:8080
OLLAMA_MODEL=/home/karr/kitt-ai/models/qwen2.5-3b-instruct-q5_k_m.gguf
OLLAMA_FALLBACK_MODEL=/home/karr/kitt-ai/models/qwen2.5-3b-instruct-q5_k_m.gguf
OLLAMA_KEEP_ALIVE=-1

# Doit couvrir le prompt système Kyronext (~1200 tokens) et la réponse.
OLLAMA_NUM_CTX=3072

# GPU layers maximal pour Orin Nano 8Go
OLLAMA_NUM_GPU=99

# ============================================================================
# Paramètres Streaming HYPER RAPIDE - MOT-A-MOT EN TEMPS REEL
# ============================================================================

# Découpage naturel par propositions : virgule ou ponctuation forte
STREAMING_MIN_WORDS=3
STREAMING_MIN_CHARS=12
STREAMING_MAX_DELAY_MS=2500
STREAMING_MAX_QUEUE_SIZE=8

# ============================================================================
# Paramètres TTS (Piper) - PARALLELE ET INSTANTANE
# ============================================================================
KYRONEX_TTS_ENABLED=1
KYRONEX_TTS_DEVICE=cuda
KYRONEX_AUDIO_PRELOAD=0

# Pré-chargement du modèle Whisper pour STT instantané
KYRONEX_WHISPER_PRELOAD=1
KYRONEX_WHISPER_MODEL=small
KYRONEX_WHISPER_DEVICE=cuda
KYRONEX_WHISPER_COMPUTE_TYPE=int8_float16

# TTS séquentiel pour conserver l ordre naturel des propositions
KYRONEX_PARALLEL_TTS=1
KYRONEX_TTS_CONCURRENCY=1
KYRONEX_TTS_IMMEDIATE=0

# ============================================================================
# Paramètres Réseau & Server
# ============================================================================
KYRONEX_HOST=0.0.0.0
KYRONEX_PORT=3000
KYRONEX_LOG_LEVEL=DEBUG

# ============================================================================
# Paramètres de Génération (pour réponses ultra-rapides et cohérentes)
# ============================================================================
LLM_TEMPERATURE=0.25
LLM_TOP_P=0.95
LLM_MAX_TOKENS=120
LLM_REPEAT_PENALTY=1.1

# ============================================================================
# Optimisations Spécifiques Nano 8Go - POUR LATENCE MINIMALE
# ============================================================================
# Batch size ultra-réduit pour premier token INSTANTANE
LLAMA_BATCH_SIZE=64
LLAMA_UBATCH_SIZE=64
LLAMA_THREADS=6
LLAMA_THREADS_BATCH=2

# Flash Attention activé (accélère l'attention)
LLAMA_FLASH_ATTN=on

# Mode de chargement le plus rapide
LLAMA_LOAD_MODE=mmap

# Désactiver le warmup pour démarrer plus vite
LLAMA_NO_WARMUP=1

# Prefill batch size pour réduire la latence du premier token
LLAMA_PREFILL_BATCH_SIZE=64

# ============================================================================
# Paramètres Spécifiques Streaming
# ============================================================================
# Forcer le streaming même sur les modèles non-optimisés
LLAMA_STREAMING=1
LLAMA_STREAMING_TOKENS=1

# Timeout réduit pour détection rapide des erreurs
LLAMA_TIMEOUT=60

# ============================================================================
# Optimisations Expérimentales
# ============================================================================
# Kernel tuning pour réduire la latence
KYRONEX_LOW_LATENCY=1

# Désactiver le logging détaillé en production pour gagner en performance
# (à activer pour le debug si nécessaire)
KYRONEX_DEBUG_STREAMING=0

# ============================================================================
# Notes pour Orin Nano 8Go
# ============================================================================
# Cette configuration est optimisée pour:
# - Premier token: <80ms
# - Streaming: MOT-A-MOT (1-2 mots)
# - TTS: PARALLELE avec la génération
# - Latence perçue: INSTANTANEE
#
# Si instable, augmenter légèrement:
# - OLLAMA_NUM_CTX à 768
# - LLAMA_BATCH_SIZE à 96
# - STREAMING_MAX_DELAY_MS à 60
