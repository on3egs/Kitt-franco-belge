# Configuration HYPER FLUIDE pour Kyronext - Orin NX 8Go (K-4000)
# Optimisé pour des réponses INSTANTANEES avec TTS PARALLELE
# Date: 2026-07-29
# Modèle: Qwen 2.5 3B Q5_K_M
# Objectif: Répondre et PARLER EN MEME TEMPS que la génération du texte

# ============================================================================
# Paramètres LLM (llama-server / Ollama) - OPTIMISE POUR LA LATENCE
# ============================================================================
OLLAMA_HOST=http://127.0.0.1:8080
OLLAMA_MODEL=/home/karr/kitt-ai/models/qwen2.5-3b-instruct-q5_k_m.gguf
OLLAMA_FALLBACK_MODEL=/home/karr/kitt-ai/models/qwen2.5-3b-instruct-q5_k_m.gguf
OLLAMA_KEEP_ALIVE=-1

# Contexte réduit pour latence minimale mais suffisant pour la conversation
OLLAMA_NUM_CTX=1024

# GPU layers maximal pour Orin NX 8Go
OLLAMA_NUM_GPU=99

# ============================================================================
# Paramètres Streaming HYPER RAPIDE - MOT-A-MOT EN TEMPS REEL
# ============================================================================

# Découpage ultra-agressif : envoie des segments dès 1 mot
STREAMING_MIN_WORDS=1
STREAMING_MIN_CHARS=3
STREAMING_MAX_DELAY_MS=30  # 30ms max avant envoi forcé (encore plus rapide que Nano)
STREAMING_MAX_QUEUE_SIZE=8  # File TTS plus grande pour parallélisme

# ============================================================================
# Paramètres TTS (Piper) - PARALLELE ET INSTANTANE
# ============================================================================
KYRONEX_TTS_ENABLED=1
KYRONEX_TTS_DEVICE=cuda
KYRONEX_AUDIO_PRELOAD=0

# Pré-chargement du modèle Whisper pour STT instantané
KYRONEX_WHISPER_PRELOAD=1
KYRONEX_WHISPER_MODEL=base
KYRONEX_WHISPER_DEVICE=cuda
KYRONEX_WHISPER_COMPUTE_TYPE=int8_float16

# Activation du TTS PARALLELE - NE PAS ATTENDRE la fin de la génération
KYRONEX_PARALLEL_TTS=1
KYRONEX_TTS_CONCURRENCY=4  # Nombre de synthèses simultanées
KYRONEX_TTS_IMMEDIATE=1  # Commencer TTS immédiatement, sans buffer

# Spécifique K-4000: Streaming TTS par phrases ultra-courtes
K4000_STREAMING_TTS=1
K4000_PARALLEL_TTS=1
K4000_MIN_PHRASE_LENGTH=2  # Même 2 mots déclenchent le TTS
K4000_MAX_PHRASE_LENGTH=8  # Ne pas attendre plus de 8 mots

# ============================================================================
# Paramètres Réseau & Server
# ============================================================================
KYRONEX_HOST=0.0.0.0
KYRONEX_PORT=3000
KYRONEX_LOG_LEVEL=DEBUG

# ============================================================================
# Paramètres de Génération (pour réponses ultra-rapides et cohérentes)
# ============================================================================
LLM_TEMPERATURE=0.25  # Très basse pour cohérence maximale avec K-4000
LLM_TOP_P=0.92
LLM_MAX_TOKENS=150  # Limite pour réponses rapides
LLM_REPEAT_PENALTY=1.15

# ============================================================================
# Optimisations Spécifiques NX 8Go - POUR LATENCE MINIMALE
# ============================================================================
# Batch size optimisé pour NX (meilleur compromis latence/débit)
LLAMA_BATCH_SIZE=96
LLAMA_UBATCH_SIZE=96
LLAMA_THREADS=4
LLAMA_THREADS_BATCH=2

# Flash Attention activé (accélère l'attention)
LLAMA_FLASH_ATTN=on

# Mode de chargement le plus rapide
LLAMA_LOAD_MODE=mmap

# Désactiver le warmup pour démarrer plus vite
LLAMA_NO_WARMUP=1

# Prefill batch size pour réduire la latence du premier token
LLAMA_PREFILL_BATCH_SIZE=96

# ============================================================================
# Paramètres Spécifiques Streaming
# ============================================================================
# Forcer le streaming même sur les modèles non-optimisés
LLAMA_STREAMING=1
LLAMA_STREAMING_TOKENS=1  # Envoyer chaque token individuellement

# Timeout réduit pour détection rapide des erreurs
LLAMA_TIMEOUT=60

# ============================================================================
# Optimisations Expérimentales
# ============================================================================
# Kernel tuning pour réduire la latence
KYRONEX_LOW_LATENCY=1

# Désactiver le logging détaillé en production pour gagner en performance
# (à activer pour le debug si nécessaire)
KYRONEX_DEBUG_STREAMING=0

# ============================================================================
# Notes pour Orin NX 8Go (K-4000)
# ============================================================================
# Cette configuration est optimisée pour:
# - Premier token: <60ms
# - Streaming: MOT-A-MOT (1-2 mots)
# - TTS: PARALLELE avec la génération (commence à parler AVANT la fin)
# - Latence perçue: INSTANTANEE
# - Débit: ~20-22 tok/s (maintenu malgré batch réduit)
#
# Si instable, augmenter légèrement:
# - OLLAMA_NUM_CTX à 1536
# - LLAMA_BATCH_SIZE à 128
# - STREAMING_MAX_DELAY_MS à 50
