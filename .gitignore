# =============================================================================
# KITT Franco-Belge - .gitignore Global
# =============================================================================

# ====================
# 1. Environnement
# ====================
.env
.env.*
!.env.example
.env.local
.env.development
.env.production
.env.test

# ====================
# 2. Python
# ====================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
ENV/

# ====================
# 3. Node.js / Frontend
# ====================
node_modules/
.pnpm-store/
.pnp/
.pnp.js

# ====================
# 4. Build & Distribution
# ====================
build/
dist/
*.dist
.next/
.nuxt/
.out/

# ====================
# 5. Logs & Runtime Data
# ====================
*.log
logs/
*.pid
*.seed
*.lock

# Fichiers de log spécifiques
karr_vram.log
kitt_vram.log

# ====================
# 6. Données Sensibles (Tunnels, Clés API, Certificats)
# ====================
tunnel*.json
tunnel_*.json
karr*.json
k4000*.json
*.pem
*.key
*.crt
*.pfx

# ====================
# 7. Bases de Données & Cache
# ====================
*.db
*.sqlite
*.sqlite3
memory.db
assistant_memory.db

# ====================
# 8. Fichiers Audio/Video (trop lourds pour Git)
# ====================
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.webm

# ====================
# 9. Modèles IA (trop lourds pour Git)
# ====================
models/
*.gguf
*.bin
*.safetensors
*.pt
*.pth
piper/

# ====================
# 10. Backups & Fichiers Temporaires
# ====================
*.bak
*.bak-*
*.backup
*.backup_*
backups/
BACKUP_*/
*.tar.gz
*.zip

# ====================
# 11. IDE & Éditeurs
# ====================
.vscode/
.idea/
*.swp
*.swo
*~

# ====================
# 12. OS & Système
# ====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ====================
# 13. Tests & Coverage
# ====================
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/

# ====================
# 14. Données Utilisateur (Privées)
# ====================
memory.json
users.json
conn_stats.json
user_memories/
conv_data/
audio_cache/

# ====================
# 15. Fichiers de Configuration Locaux
# ====================
config.local.json
settings.local.json

# ====================
# 16. Cache Divers
# ====================
.cache/
.trt_cache/

# ====================
# 17. Fichiers Générés Automatiquement
# ====================
*.tsbuildinfo
.pdm.toml

# ====================
# 18. Scripts de Patch Temporaires (à ne pas commiter)
# ====================
fix_*.py
patch_*.py
revert_*.py

# =============================================================================
# FIN - Ne rien ajouter après cette ligne
# =============================================================================
