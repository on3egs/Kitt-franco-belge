+    let timer = null;
+    try {
+      await Promise.race([
+        context.resume(),
+        new Promise((_, reject) => { timer = setTimeout(() => reject(new Error('Moteur audio bloque: touchez AUTO ou MIC ON pour autoriser le mode ecoute.')), 8000); })
+      ]);
+    } finally {
+      if (timer) clearTimeout(timer);
+    }
+  }
