# Copier ce fichier vers .env ou le référencer depuis le service systemd local.
# Ne jamais versionner .env. Les valeurs ci-dessous sont uniquement des exemples.
KYRONEXT_HOST=0.0.0.0
KYRONEXT_PORT=3000
KYRONEXT_LLM_URL=http://127.0.0.1:8080
KYRONEXT_PIPER_PYTHON=/opt/kyronext/.venv/bin/python
KYRONEXT_VOICE_DIR=/opt/kyronext/models/voices
KYRONEXT_WHISPER_MODEL=/opt/kyronext/models/whisper-base
KYRONEXT_SECRET_OWNER_PASSWORD=YOUR_PASSWORD_HERE
